# Connection string do banco Postgres.
# Local (Docker, via docker-compose.yml): postgresql://oiko:oiko@localhost:5432/oiko?schema=public
# Neon: crie um projeto em https://neon.tech, copie a connection string (com "?sslmode=require")
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/oiko?sslmode=require"

# Chave usada pelo NextAuth (Auth.js) para assinar sessões/JWTs.
# Gere uma com: openssl rand -base64 32
AUTH_SECRET="cole-uma-chave-aleatoria-aqui"
